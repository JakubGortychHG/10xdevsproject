---
import Layout from "@/layouts/Layout.astro";
import RegisterForm from "@/components/auth/RegisterForm";
---

<Layout title="Rejestracja - 10xCards">
  <div class="container max-w-md mx-auto py-8">
    <div class="space-y-6">
      <div class="text-center">
        <h1 class="text-2xl font-bold">Utwórz konto w 10xCards</h1>
        <p class="text-muted-foreground mt-2">
          Wprowadź swoje dane aby utworzyć konto
        </p>
      </div>

      <RegisterForm client:load />

      <p class="text-center text-sm">
        Masz już konto?{" "}
        <a href="/auth/login" class="text-primary hover:underline">
          Zaloguj się
        </a>
      </p>
    </div>
  </div>
</Layout>
