---
import Layout from "@/layouts/Layout.astro";
import LoginForm from "@/components/auth/LoginForm";
import { AuthService } from "@/lib/services/authService";

// Initialize auth service
const authService = AuthService.getInstance();
authService.initializeClient({
  cookies: Astro.cookies,
  headers: Astro.request.headers,
});

// Get URL parameters
const reason = Astro.url.searchParams.get("reason");
let returnTo = Astro.url.searchParams.get("returnTo") || "/generate";

// Clear any existing session if coming from logout
if (reason === "logout") {
  await authService.signOut();
  // After logout, always redirect to home page
  returnTo = "/generate";
}

// TEMPORARY FIX: Don't check if user is logged in on login page
// This prevents false redirects due to potentially invalid cookies
console.log(
  "DEBUG: Login page - skipping user check to prevent false redirects",
);
---

<Layout title="Logowanie - 10xCards">
  <div class="container max-w-md mx-auto py-8">
    <div class="space-y-6">
      <div class="text-center">
        <h1 class="text-2xl font-bold">Zaloguj się do 10xCards</h1>
        <p class="text-muted-foreground mt-2">
          Wprowadź swoje dane aby kontynuować
        </p>
      </div>

      <LoginForm client:load returnTo={returnTo} />

      <p class="text-center text-sm">
        Nie masz jeszcze konta?{" "}
        <a href="/auth/register" class="text-primary hover:underline">
          Zarejestruj się
        </a>
      </p>
    </div>
  </div>
</Layout>
