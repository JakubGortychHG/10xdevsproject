---
import Layout from "@/layouts/Layout.astro";
import RequestPasswordResetForm from "@/components/auth/RequestPasswordResetForm";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";

const token = Astro.url.searchParams.get("token");
---

<Layout title="Reset hasła - 10xCards">
  <div class="container max-w-md mx-auto py-8">
    <div class="space-y-6">
      <div class="text-center">
        <h1 class="text-2xl font-bold">
          {token ? "Ustaw nowe hasło" : "Reset hasła"}
        </h1>
        <p class="text-muted-foreground mt-2">
          {token
            ? "Wprowadź nowe hasło dla swojego konta"
            : "Wprowadź swój email aby zresetować hasło"}
        </p>
      </div>

      {token ? (
        <ResetPasswordForm token={token} client:load />
      ) : (
        <RequestPasswordResetForm client:load />
      )}

      <p class="text-center text-sm">
        <a href="/auth/login" class="text-primary hover:underline">
          Powrót do logowania
        </a>
      </p>
    </div>
  </div>
</Layout> 